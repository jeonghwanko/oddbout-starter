{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!vendor",
      "!website/**/review-*",
      "!contracts",
      "!server"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "useTemplate": "off",
        "useConst": "warn"
      },
      "suspicious": {
        "noControlCharactersInRegex": "off",
        "noAssignInExpressions": "off",
        "noThenProperty": "off",
        "noShadowRestrictedNames": "off",
        "useIterableCallbackReturn": "warn"
      },
      "correctness": {
        "noUnsafeOptionalChaining": "warn",
        "noUnsafeFinally": "warn",
        "noConstantCondition": "warn"
      },
      "a11y": {
        "noSvgWithoutTitle": "off"
      }
    }
  },
  "html": {
    "linter": {
      "enabled": false
    }
  }
}
