  "license": "MIT",
  "type": "module",
  "bin": {
    "oddbout-host": "runner.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jeonghwanko/oddbout-starter.git",
    "directory": "host"
  },
  "homepage": "https://oddbout.com",
  "files": [
    "runner.mjs",
    "install.mjs",
    "pinned.mjs",
    "pins.json",
    "cli/grok/package.json",
    "cli/grok/lock.json",
    "cli/codex/package.json",
    "cli/codex/lock.json",
    "og.mjs",
    "og",
    "generation-worker.mjs",
    "generation-stages.mjs",
    "codex-usage.mjs",
    "sprite-outcome.mjs",
    "ledger-report.mjs",
    "motions.py",
    "style-anchor-front.webp"
  ],
  "scripts": {
