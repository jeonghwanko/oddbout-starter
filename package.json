{
  "name": "oddbout-starter",
  "version": "0.6.20",
  "description": "Local Dot/Codex MCP starter for AI Fighter authoring and package validation",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jeonghwanko/oddbout-starter.git"
  },
  "scripts": {
    "broadcast:dev": "node scripts/broadcast-demo.mjs",
    "campaign:check": "node --test --test-concurrency=2 test/campaigns.test.mjs test/campaign-media.test.mjs test/campaign-links.test.mjs test/campaign-postgres.test.mjs test/browser/campaign-shop.test.mjs",
    "paid:mcp": "node scripts/paid-operation-mcp.mjs",
    "paid:check": "node --test --test-concurrency=2 test/paid-operations.test.mjs test/paid-recovery.test.mjs test/broadcast-paid-recovery.test.mjs test/showrunner-commerce.test.mjs test/browser/paid-operations.test.mjs test/browser/broadcast-recovery.test.mjs test/browser/showrunner-storefront.test.mjs",
    "broadcast:doctor": "node scripts/broadcast-host.mjs --doctor",
    "broadcast:runner": "node scripts/broadcast-runner.mjs",
    "broadcast:producer": "node scripts/broadcast-producer.mjs",
    "broadcast:check-ui": "node --test test/browser/broadcast-console.test.mjs",
    "broadcast:check-renderer": "node scripts/check-broadcast-renderer.mjs",
    "broadcast:release": "node scripts/broadcast-release.mjs",
    "site:build": "node scripts/build-creator-site.mjs",
    "site:publish": "node scripts/publish-creator-site.mjs",
    "site:republish": "node scripts/republish-site.mjs",
    "worker:deploy": "node scripts/deploy-render.mjs",
    "gateway:deploy": "wrangler deploy -c cloudflare/mcp-gateway/wrangler.toml",
    "gateway:dev": "wrangler dev -c cloudflare/mcp-gateway/wrangler.toml",
    "gateway:smoke": "node scripts/gateway-smoke.mjs",
    "public-api:deploy": "wrangler deploy -c cloudflare/public-api/wrangler.toml",
    "connect": "node packages/oddbout/bin/oddbout.mjs connect",
    "login": "node scripts/login.mjs",
    "logout": "node scripts/login.mjs logout",
    "admin": "node scripts/admin.mjs",
    "sprite:setup": "node scripts/sprite-gen.mjs setup",
    "sprite:status": "node scripts/sprite-gen.mjs status",
    "sprite": "node scripts/sprite-gen.mjs",
    "fighter:pack": "node scripts/pack-fighter.mjs",
    "fighter:gait": "node scripts/gait.mjs",
    "fighter:contact": "node scripts/contact.mjs",
    "fighter:profile-set": "node scripts/profile-set.mjs",
    "fighter:register": "node scripts/register-fighter.mjs",
    "flow:test": "node scripts/flow-test.mjs",
    "flow:eval": "node scripts/flow-eval.mjs",
    "flow:mcp": "node scripts/flow-mcp.mjs",
    "example": "node scripts/create-example.mjs",
    "validate": "node tools/ai-fighter/validate-package.mjs",
    "test": "node --test test/*.test.mjs host/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.vendored.json",
    "lint": "biome lint --error-on-warnings . && prettier --check \"**/*.{mjs,js,cjs,ts}\"",
    "format": "prettier --write \"**/*.{mjs,js,cjs,ts}\"",
    "test:fast": "node scripts/test-suite.mjs fast",
    "test:heavy": "node scripts/test-suite.mjs heavy",
    "spec:check": "node tools/ai-fighter/build-contract.mjs --check",
    "spec:build": "node tools/ai-fighter/build-contract.mjs",
    "contract:vendored": "node tools/ai-fighter/vendored-contract.mjs",
    "mcp:smoke": "node scripts/mcp-smoke.mjs",
    "creation:context": "node scripts/creation-context.mjs",
    "creation:delivery": "node scripts/check-creation-delivery.mjs",
    "creation:run": "node scripts/run-creation-job.mjs",
    "creation:tool": "node scripts/creation-tool.mjs",
    "creation:preflight": "node scripts/creation-preflight.mjs",
    "creation:plan": "node scripts/creation-plan.mjs",
    "dots:doctor": "node scripts/dots-workspace.mjs doctor",
    "dots:bootstrap": "node scripts/dots-workspace.mjs bootstrap",
    "dots:resume": "node scripts/dots-workspace.mjs resume",
    "plugin:build": "node scripts/build-local-plugin.mjs",
    "plugin:bundle": "node scripts/build-plugin-bundle.mjs",
    "kit:release": "node scripts/prepare-creator-release.mjs",
    "worker:once": "node worker/run.mjs",
    "worker:watch": "node worker/run.mjs --watch",
    "host": "node scripts/host.mjs",
    "host:setup": "node scripts/host.mjs setup",
    "host:login": "node scripts/host.mjs login",
    "host:start": "node scripts/host.mjs start",
    "judge:eval": "node scripts/judge-eval.mjs",
    "dots:start": "node scripts/dots-start.mjs",
    "dots:source": "node scripts/dots-source.mjs",
    "mcp:check": "node scripts/check-cloud-discovery.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@supabase/supabase-js": "2.117.3",
    "ajv": "6.15.0",
    "qrcode": "1.5.4",
    "sharp": "0.35.5",
    "undici": "7.30.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@electric-sql/pglite": "0.5.10",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "miniflare": "5.20261103.0-beta",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "wrangler": "4.157.0"
  }
}
