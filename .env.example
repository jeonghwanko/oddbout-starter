# Optional isolated PayPal Sandbox development server. No secrets are included.
# Load explicitly: node --env-file=.env scripts/broadcast-demo.mjs
# Copy only the fields needed for this machine; never use production database keys here.
ODDBOUT_COMMERCE_ENABLED=0
ODDBOUT_COMMERCE_ORIGIN=http://127.0.0.1:5180
ODDBOUT_BROADCAST_PORT=5180
# A dedicated hosted Sandbox may set 0.0.0.0 behind TLS; requires an HTTPS origin.
# On hosting platforms, omit ODDBOUT_BROADCAST_PORT to use PORT instead.
ODDBOUT_BROADCAST_BIND_HOST=127.0.0.1
ODDBOUT_BROADCAST_HOST_IDS=current-pc,office-stable,svl-mac-01
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
PAYPAL_SANDBOX_MERCHANT_ID=
PAYPAL_SANDBOX_WEBHOOK_ID=
# Server only: JSON array of {"hostId":"current-pc","token":"<32+ random characters>"}.
# Generate private tokens locally. Keep worker credentials out of browser/MCP arguments.
ODDBOUT_BROADCAST_WORKERS_JSON=[]
# Server only: producer grants for ALREADY APPROVED broadcast sessions.
# Each entry: {"owner":"<user UUID>","broadcastId":"<session UUID>",
# "token":"obp_<32+ random characters>","expiresAt":"<ISO timestamp>"}.
# Never substitute a full Supabase user token. The server binds every tool to this session.
ODDBOUT_BROADCAST_PRODUCERS_JSON=[]

# Selected host only. Match obsPasswordEnv in deploy/broadcast-hosts.json.
ODDBOUT_OBS_PASSWORD=
ODDBOUT_BROADCAST_API_ORIGIN=http://127.0.0.1:5180
ODDBOUT_BROADCAST_WORKER_TOKEN=
ODDBOUT_BROADCAST_ARENA_URL=http://127.0.0.1:5178/broadcast.html
# Optional explicit installed browser: chrome or msedge. Empty uses Playwright Chromium.
# There is no automatic browser fallback.
ODDBOUT_BROADCAST_BROWSER_CHANNEL=

# Optional producer only. Choose a model explicitly; API billing is separate from demo credits.
ODDBOUT_BROADCAST_MCP_URL=http://127.0.0.1:5180/mcp
# Session-scoped obp_ token configured on the server above; never a Supabase access token.
ODDBOUT_BROADCAST_MCP_TOKEN=
ODDBOUT_BROADCAST_MODEL=
OPENAI_API_KEY=
ODDBOUT_BROADCAST_MAX_MODEL_CALLS=24
ODDBOUT_BROADCAST_MAX_OUTPUT_TOKENS=600
# Demo server only (opt-in): run the producer automatically for every started session.
# 1 requires ODDBOUT_BROADCAST_MODEL and OPENAI_API_KEY above; the server refuses to start without them.
ODDBOUT_BROADCAST_AUTO_PRODUCER=0
ODDBOUT_BROADCAST_AUTO_PRODUCER_MAX_ACTIVE=3
ODDBOUT_BROADCAST_AUTO_PRODUCER_DAILY_CALLS=200
# Keep on a persistent disk: a restart then resumes producers instead of losing their checkpoints.
ODDBOUT_BROADCAST_PRODUCER_STATE_DIR=.oddbout-broadcast/producers
# Demo server only (opt-in): the console's AI concierge (balance, prices, quotes, PayPal Sandbox top-up).
# 1 requires ODDBOUT_BROADCAST_MODEL and OPENAI_API_KEY above. It cannot approve budgets or start sessions.
ODDBOUT_BROADCAST_CONCIERGE=0
ODDBOUT_BROADCAST_CONCIERGE_DAILY_CALLS=300
