{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git worktree list:*)",
      "Bash(git submodule status:*)",
      "Bash(node --test:*)",
      "Bash(npm run test:fast:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run spec:check:*)",
      "Bash(npm run validate:*)",
      "Bash(npm run mcp:smoke:*)"
    ],
    "deny": [
      "Bash(git add -A:*)",
      "Bash(git add --all:*)",
      "Bash(git add .)",
      "Bash(git add -u:*)",
      "Bash(git commit -a:*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.env.broadcast)",
      "Read(./.env.npm)"
    ]
  }
}
