  "profile": {
    "name": "야근왕 박과장",
    "description": "둥근 배와 낡은 서류가방이 트레이드마크인 40대 한국인 회사원. 피곤한 눈빛도 공이 울리면 의외의 당당함으로 바뀐다.",
    "language": "ko",
    "concept": "평소에는 소심하지만 경기장에서는 배짱 넘치는 코믹 격투가. 뱃살의 탄력으로 공격을 튕기고 서류가방을 휘두르며, 우승 상금으로 야근 없는 휴가를 꿈꾼다.",
    "names": {
      "en": "Overtime King Mr. Park",
      "ko": "야근왕 박과장"
    },
    "lines": {
      "win": "야근왕 박과장, 승리 결재 완료!",
      "lose": "야근왕 박과장… 재도전은 내일 출근해서.",
      "challenge": "야근왕 박과장, 오늘은 정시에 끝내겠습니다!"
    },
    "portrait": {
      "assetId": "idle",
      "crop": {
        "x": 12,
        "y": 0,
        "width": 120,
        "height": 120
      }
    },
    "preview": {
      "assetId": "idle",
      "crop": {
        "x": 0,
        "y": 0,
        "width": 159,
        "height": 416
      }
    },
    "moves": {
      "combo": {
        "name": "결재 도장 3연타",
        "description": "결재 도장으로 찌르고, 서류 뭉치로 한 방 휘두른 뒤 서류가방 어퍼컷으로 띄운다. 맞을 때마다 빨간 ‘반려’ 도장이 찍힌다."
      },
      "slam": {
        "name": "뱃살 결재 프레스",
        "description": "넥타이를 매만진 뒤 뛰어올라 둥근 뱃살로 내리누르는 강타. 충격에 서류가 사방으로 흩어진다."
      },
      "dash": {
        "name": "회식 노래방 각성",
        "description": "넥타이를 머리띠로 묶고 서류가방을 마이크 삼아 돌진하는 회식 노래방 각성. 슬라이드 하이노트에 맞춰 부딪힌다."
      },
      "block": {
        "name": "뱃살 반사 쿠션",
        "description": "둥근 뱃살을 방패처럼 내밀어, 들어온 공격을 탄력으로 튕겨 낸다."
      }
    }
  },
